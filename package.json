{
  "name": "browse-loom",
  "version": "1.2.0",
  "private": true,
  "description": "A calm, local-first workspace for tabs, bookmarks, and browsing sessions.",
  "scripts": {
    "dev": "npm run dev:host",
    "dev:host": "bash scripts/launch-chrome-testing.sh",
    "package": "node scripts/package-extension.mjs",
    "package:chrome": "node scripts/package-extension.mjs chrome",
    "package:edge": "node scripts/package-extension.mjs edge",
    "capture:store-assets": "node scripts/capture-store-screenshots.mjs",
    "test": "node tests/run-tests.mjs",
    "test:browser": "node scripts/test-chrome-extension.mjs",
    "validate": "npm run package && node scripts/validate-extension.mjs",
    "test:bookmarks": "node scripts/test-chrome-extension.mjs --native-bookmarks"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
